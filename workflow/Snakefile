# This workflow follows the ENCODE ATAC-seq pipeline (v2.2.3):
# https://github.com/ENCODE-DCC/atac-seq-pipeline
# https://www.encodeproject.org/atac-seq/

# Only mouse and human genomes are supported for now


# Load configuration
# -----------------------------------------------------
configfile: "config/config.yaml"


include: "rules/common.smk"


# URLs and file names of the genome fasta and GTF files
resources = GenomeFiles(config["genome"]["ensembl"], config["genome"]["release"])
SAMPLES = samples()
CONDITIONS = conditions()


wildcard_constraints:
    sample="[a-zA-Z0-9_]+",
    condition="[a-zA-Z0-9_]+",
    read="R1|R2",
    prefix=r"(pooled/)?[a-zA-Z0-9_]+(\.pr[12])?",
    pair=r"rep\d+_vs_rep\d+|rep\d+-pr1_vs_rep\d+-pr2|pooled-pr1_vs_pooled-pr2",
    method="idr|overlap",
    contrast="[a-zA-Z0-9_]+",


# Load rules
# -----------------------------------------------------
include: "rules/process_reads.smk"
include: "rules/atac.smk"
include: "rules/bigwig.smk"
include: "rules/qc.smk"
include: "rules/deseq2.smk"
include: "rules/te.smk"
include: "rules/te_peaks.smk"
include: "rules/te_qc.smk"


onstart:
    print("\n--- Analysis started ---\n")


onsuccess:
    print("\n--- Workflow finished! ---\n")


onerror:
    print("\n--- An error occurred! ---\n")


# Target rules
# -----------------------------------------------------
# ENCODE peaks, signal tracks and QC, and the optional comparison of all
# samples (skipped with te: only)
ENCODE_TARGETS = []
if not te_only():
    ENCODE_TARGETS = [
        "results/multiqc/multiqc_report.html",
        "results/ataqv_report/index.html",
        "results/qc/encode_qc_summary.tsv",
        *expand(
            "results/{method}/{condition}/optimal_peak_annotated.txt",
            method=reproducibility_methods(),
            condition=CONDITIONS,
        ),
        # Peaks reproducible in several replicates (conditions with replicates)
        *expand(
            "results/{method}/{condition}/replicated_peak.narrowPeak",
            method=reproducibility_methods(),
            condition=[c for c in CONDITIONS if len(replicates(c)) > 1],
        ),
        *expand(
            "results/bigwig/{prefix}.{signal}.signal.bigwig",
            prefix=SAMPLES + [f"pooled/{c}" for c in CONDITIONS],
            signal=["fc", "pval"],
        ),
    ]
    if deseq2_enabled():
        ENCODE_TARGETS += [
            "results/deseq2/pca.png",
            "results/deseq2/sample_correlation.png",
            *expand(
                "results/deseq2/{contrast}/differential_peaks.tsv",
                contrast=deseq2_contrasts(),
            ),
        ]

# Optional TE module
TE_TARGETS = []
if te_enabled():
    TE_TARGETS = [
        "results/te/te_subfamily.tsv",
        "results/te/te_family.tsv",
        "results/te/te_class.tsv",
        "results/te/te_library_stats.tsv",
        "results/te/qc/te_qc_summary.tsv",
        "results/te/multiqc/multiqc_report.html",
        *expand("results/te/bigwig/{sample}.cpm.bigwig", sample=SAMPLES),
        *expand("results/te/bigwig/mean/{condition}.cpm.bigwig", condition=CONDITIONS),
        "results/te/peaks/consensus_peaks_repeats.tsv",
        "results/te/peaks/consensus_peaks_frac_unique.bed",
        *expand(
            "results/te/peaks/overlap/{condition}/replicated_peak.narrowPeak",
            condition=CONDITIONS,
        ),
    ]
    if deseq2_enabled():
        TE_TARGETS += [
            # PCA and sample correlation of the subfamilies and the TE peaks
            *expand(
                "results/te/{level}/{file}",
                level=["deseq2", "peaks/deseq2"],
                file=["pca.png", "sample_correlation.png"],
            ),
            *expand(
                "results/te/deseq2/{contrast}/differential_subfamilies.tsv",
                contrast=deseq2_contrasts(),
            ),
            *expand(
                "results/te/peaks/deseq2/{contrast}/{file}",
                contrast=deseq2_contrasts(),
                file=[
                    "differential_peaks.tsv",
                    "more_accessible.bed",
                    "less_accessible.bed",
                ],
            ),
        ]
        if te_correlation_config()["datasets"]:
            TE_TARGETS += expand(
                "results/te/correlation/{contrast}/venn.png",
                contrast=deseq2_contrasts(),
            )
    if te_profile_config()["subfamilies"]:
        TE_TARGETS += expand(
            "results/te/profile/{level}.png", level=["conditions", "samples"]
        )


localrules:
    all,


rule all:
    input:
        ENCODE_TARGETS,
        TE_TARGETS,
