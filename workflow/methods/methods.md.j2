{% if deseq2 %}
{# The TE peaks always use DESeq2's median-of-ratios size factors #}
TE peaks were analysed with DESeq2 as the
{% if te_only %}
subfamilies, but with median-of-ratios size factors over the peaks,
{% else %}
consensus peaks
{% endif %}
and annotated with
{% if te_only %}
{{ chipseeker_text() | trim }}
{% else %}
ChIPseeker
